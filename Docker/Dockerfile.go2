FROM ros:foxy

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# `source` is a bash builtin, needed by the workspace build below
SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Unitree ROS2 Package \
    ros-foxy-rmw-cyclonedds-cpp \
    ros-foxy-rosidl-generator-dds-idl \
    # Unitree SDK2 Python Package \
    python3-pip \
    # Unitree SDK2 C++ Package \
    cmake \
    g++ \
    build-essential \
    libeigen3-dev \
    libboost-all-dev \
    libspdlog-dev \
    libfmt-dev \
    # ROS2 + SDK2 C++ \
    libyaml-cpp-dev \
    # ROS2 General Dependencies \
    ros-foxy-desktop \
    python3-colcon-common-extensions \
    python3-vcstool \
    python3-rosdep \
    libpython3-dev \
    # Misc \
    neovim \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/unitree && \
    git clone https://github.com/unitreerobotics/unitree_sdk2_python.git /opt/unitree/unitree_sdk2_python && \
    git clone https://github.com/unitreerobotics/unitree_sdk2.git        /opt/unitree/unitree_sdk2 && \
    git clone https://github.com/unitreerobotics/unitree_ros2.git        /opt/unitree/unitree_ros2

# The workspace lives *inside* the unitree_ros2 clone: its cyclonedds_ws/src
# already holds the unitree_go / unitree_api / unitree_hg message packages, and
# rmw_cyclonedds + cyclonedds get cloned in next to them. Building anywhere else
# produces a CycloneDDS workspace with no Unitree messages in it.
# https://github.com/unitreerobotics/unitree_ros2/blob/master/README.md
ENV UNITREE_ROS2_WS=/opt/unitree/unitree_ros2/cyclonedds_ws

RUN cd ${UNITREE_ROS2_WS}/src && \
    git clone https://github.com/ros2/rmw_cyclonedds -b foxy && \
    git clone https://github.com/eclipse-cyclonedds/cyclonedds -b releases/0.10.x && \
    cd .. && \
    export LD_LIBRARY_PATH=/opt/ros/foxy/lib && \
    colcon build --packages-select cyclonedds && \
    source /opt/ros/foxy/setup.bash && \
    colcon build

# CMake package root for CycloneDDS, used by unitree_sdk2 and unitree_sdk2_python.
# colcon installs each package under install/<pkg>, so this is not the workspace
# root — sourcing the workspace is a separate thing, done in /etc/bash.bashrc.
ENV CYCLONEDDS_HOME=${UNITREE_ROS2_WS}/install/cyclonedds

RUN cmake -S /opt/unitree/unitree_sdk2 \
          -B /opt/unitree/unitree_sdk2/build \
          -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /opt/unitree/unitree_sdk2/build --parallel "$(( $(nproc) / 4 > 0 ? $(nproc) / 4 : 1 ))" && \
    cmake --install /opt/unitree/unitree_sdk2/build

# Running into issues with this, commenting it out for now and it can be ran manually in the container
# RUN source ${UNITREE_ROS2_WS}/install/setup.bash && \
#   pip3 install -e /opt/unitree/unitree_sdk2_python

RUN echo "source /opt/ros/foxy/setup.bash" >> /etc/bash.bashrc && \
    echo "source ${UNITREE_ROS2_WS}/install/setup.bash" >> /etc/bash.bashrc

# Baked-in fallback so the image works unmounted. `-v .../config:/config` at run
# time shadows this directory — see README, a mount from the wrong cwd silently
# hides it behind an empty dir.
COPY config/ /config/

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI=/config/cyclonedds.xml

WORKDIR /root
CMD ["bash"]
